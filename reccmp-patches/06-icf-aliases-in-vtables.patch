+        def is_icf_alias(orig: ReccmpEntity, recomp: ReccmpEntity) -> bool:
+            """EZ2DECOMP patch 06 (ICF aliases in vtables). Companion to patch 05
+            in compare/ingest.py: when the ORIGINAL's linker folded several
+            identical functions onto one address and the recomp deliberately does
+            not fold (/opt:noicf), only one of the duplicates can win the match.
+            A vtable slot pointing at one of the others then holds a recomp
+            address that is unmatched, even though it is the same function, byte
+            for byte. Patch 05 gives every such alias the winner's name, so an
+            unmatched recomp entity carrying the matched original's name IS that
+            original by construction."""
+            return (
+                recomp.orig_addr is None
+                and orig.best_name() is not None
+                and orig.best_name() == recomp.best_name()
+            )
+
