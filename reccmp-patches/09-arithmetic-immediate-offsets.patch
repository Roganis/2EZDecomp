+    def hex_replace_offset_or_address(self, match: re.Match) -> str:
+        """EZ2DECOMP patch 09. For `add reg, X` and friends, X is usually a struct
+        offset or a bit mask, but it CAN be a real address (pointer arithmetic on a
+        global). Same resolution as patch 04 uses for a displacement: name it when
+        it is the exact base of an entity, and leave it raw when it merely lands
+        INSIDE one, because then the other image has nothing there and one side
+        prints a name against the other's number - a mismatch with identical bytes.
+        (createInput @0x40c250 forms `&this->keyboard` as `add esi, 0x420104`; that
+        member offset lands inside one of our own recompiled globals.)"""
+        value = int(match.group(1), 16)
+        if not self.is_addr(value):
+            return match.group(0)
+
+        if self.lookup(value, exact=True) is not None:
+            return self.replace(value, exact=True)
+
+        if self.lookup(value) is not None:
+            return match.group(0)
+
+        return self.replace(value)
+
