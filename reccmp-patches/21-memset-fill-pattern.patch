+def _is_fill_pattern(value: int) -> bool:
+    """EZ2DECOMP patch 21: true for a 32-bit value whose four bytes are all
+    equal - the replicated byte cl materializes for an inline memset
+    (`memset(buf, 1, n)` -> `mov eax, 0x01010101; rep stosd`)."""
+    b = value & 0xFF
+    return value == b * 0x01010101
