+    def biased_base_replace(self, value: int) -> str | None:
+        """EZ2DECOMP patch 12. A displacement that sits a few bytes BELOW an
+        entity's base is a BIASED ARRAY REFERENCE, not a stray number.
+
+        cl folds the constant part of `arr[i - k]` into the addressing mode, so
+        the operand carries `arr - k` and the effective address is only ever
+        `arr + something`. The biased constant therefore points at no entity at
+        all - it is short of the array's base - so `is_addr` rejects it and both
+        sides print the raw number. The two numbers then differ purely because
+        the two images are based differently, and an otherwise byte-identical
+        function can never reach 100%.
+
+        Resolving it as `name-k` renders both sides identically. The window is
+        deliberately tiny: a genuine struct member offset would have to land
+        within a few bytes below one of the annotated globals to be caught by
+        mistake, and unlike the interior case (see below) it cannot happen at
+        all on the recomp side, where `/base` puts every entity far above any
+        offset this program can form.
+
+        (First needed by BackGround::videoName @0x41add0, which tests
+        `buf[strlen(buf) - 3]` three times over.)"""
+        for k in range(1, self.BIASED_BASE_WINDOW + 1):
+            name = self.lookup(value + k, exact=True)
+            if name is not None:
+                replacement = f"{name}-{k}"
+                self.replacements[value] = replacement
+                return replacement
+
+        return None
+
